# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/booking_dev
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/booking_test

# ─── Auth (shared between apps/web NextAuth and apps/api JWT) ──────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-minimum-32-char-random-secret
JWT_SECRET=replace-with-a-minimum-32-char-random-secret
JWT_EXPIRES_IN=7d

# NextAuth (apps/web)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-minimum-32-char-random-secret

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com.au

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
APP_URL=http://localhost:3000
APP_TIMEZONE=Australia/Perth

# ─── Seat-hold defaults (overridden at runtime by Settings table) ───────────────
SEAT_HOLD_WINDOW_MINUTES=10
REMINDER_LEAD_HOURS=24
